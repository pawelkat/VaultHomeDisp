import "./fonts/LiberationSans-Regular.ttf";

export component MainWindow inherits Window {
    width: 792px;
    height: 272px;
    background: #ffffff;
    title: "VaultHomeDisp";
    default-font-family: "Liberation Sans";
    in-out property <string> message: "";
    in-out property <string> status: "";

    // Content is the top 248px. The status line is the bottom 24px,
    // flush with the lower edge. Keep these in step with gallery::STATUS_H.
    Rectangle {
        y: 0px;
        width: 100%;
        height: 248px;
        background: #ffffff;

        Text {
            width: 100%;
            height: 100%;
            text: root.message;
            wrap: word-wrap;
            color: #000000;
            font-family: "Liberation Sans";
            font-size: 36px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    Rectangle {
        y: 248px;
        width: 100%;
        height: 24px;
        background: #ffffff;

        Text {
            width: 100%;
            height: 100%;
            text: root.status;
            color: #000000;
            font-family: "Liberation Sans";
            font-size: 14px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
